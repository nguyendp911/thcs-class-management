{
    "name": "thcs/class-management-api",
    "type": "project",
    "description": "REST API for Junior High School Class Management Website",
    "license": "MIT",
    "require": {
        "php": "^8.2",
        "laravel/framework": "*",
        "laravel/sanctum": "*",
        "laravel/tinker": "*"
    },
    "autoload": {
        "psr-4": {
            "App\\": "app/",
            "Database\\Factories\\": "database/factories/",
            "Database\\Seeders\\": "database/seeders/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Tests\\": "tests/"
        }
    },
    "config": {
        "optimize-autoloader": true,
        "preferred-install": "dist",
        "sort-packages": true,
        "audit": {
            "block": "none"
        }
    },
    "minimum-stability": "stable",
    "prefer-stable": true
}
